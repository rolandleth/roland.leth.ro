generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  summary     String?
  imageUrl    String?
  section     String   @default("tech")
  slug        String
  datetime    String
  readingTime String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([section, slug])
}

model Project {
  id             Int              @id @default(autoincrement())
  name           String
  slug           String           @unique
  summary        String
  icon           String?
  heroImage      String?
  platform       String
  role           String?
  accentColor    String?
  isFeatured     Boolean          @default(false)
  isDiscontinued Boolean          @default(false)
  date           String?
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sections       ProjectSection[]
  links          ProjectLink[]
}

model ProjectSection {
  id          Int                   @id @default(autoincrement())
  projectId   Int
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  sortOrder   Int                   @default(0)
  images      ProjectSectionImage[]
}

model ProjectSectionImage {
  id        Int            @id @default(autoincrement())
  sectionId Int
  section   ProjectSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int            @default(0)
}

model ProjectLink {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  url       String
  sortOrder Int     @default(0)
}
