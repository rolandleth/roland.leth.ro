generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  summary     String
  imageUrl    String?
  section     Section  @default(tech)
  slug        String
  // Stored as `yyyy-MM-dd-HHmm` string, not DateTime. Lex-sort on this format
  // matches chronological order, so `orderBy: { datetime: "desc" }` works as
  // intended. Keeping it as String avoids a disruptive migration that would
  // touch every caller (admin form, create/update routes, sitemap, feed,
  // `currentDatetimeString`, `yearFromDatetime`, `postDatetimeToISO`) for no
  // behavioural win at current scale. Revisit if timezone-aware queries or
  // cross-date range filtering become load-bearing.
  datetime    String
  readingTime String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([section, slug])
  // List queries filter on (section, published) then order by datetime DESC;
  // this composite index lets Postgres hit the right shard and return rows
  // in order without a sort step.
  @@index([section, published, datetime])
  // `findPostsBecameLive` deliberately does NOT filter by section — the sitemap
  // and the `posts` aggregate span sections — so the composite above can't serve
  // it: its leftmost column is absent and the query falls back to a scan. Same
  // trade as the guide side: daily, negligible today, cheap now.
  @@index([published, datetime])
  // There is deliberately NO slug-only index. One existed for
  // `legacySlug.lookupLegacySlug`, which queried by `slug` alone to resolve
  // root-level legacy URLs; that lookup and its route are gone, leaving the
  // index as write amplification on every insert and update. Every remaining
  // post query includes `section` and so uses the composite unique above.
  // Re-add it only if a genuine slug-only query reappears.
}

// Kept in sync with `SECTIONS` in src/lib/sections.ts. Adding a new value
// requires updating both and running a Prisma migration.
enum Section {
  tech
  life
}

// Maintained reference pages, edited in place from Search Console data. A
// separate model from `Post` rather than a third `Section`: Post carries legacy
// guides shouldn't inherit (the `yyyy-MM-dd-HHmm` datetime string, feed/archive/
// search surfaces, a frozen-after-publish lifecycle), and reusing it would add a
// "not guides" filter to every existing post query.
//
// `GuideTopic` groups guides into a hub page; both live in the same flat
// `/guides/:slug` URL namespace, so regrouping a guide never changes its URL.
// Cross-table slug uniqueness (Guide vs GuideTopic) has no Postgres equivalent
// across two tables — it's enforced in the app layer (`assertSlugAvailable`),
// which the admin routes and the import planner share.
model GuideTopic {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  title            String
  // The blurb rendered on a project page's guides section; `description` is the
  // hub page's own body (markdown). Two fields because the hub reads as a
  // landing page while the project page needs one scannable line.
  shortDescription String
  description      String
  // Project reference is BY SLUG, not a foreign key. `import-projects.ts`
  // replaces projects wholesale (delete-then-create inside a transaction); an
  // FK would either cascade-delete every guide or block the importer outright.
  // The slug is the stable public identity, so it's the right join key here.
  // Integrity ("this slug names a real project") is enforced in the Zod/API
  // layer and the import script, not the database.
  //
  // Nullable: a guide or topic with no product is allowed (no CTA, never listed
  // on a project page, still indexed on /guides + sitemap + llms.txt).
  projectSlug      String?
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  guides           Guide[]

  // Project pages query (projectSlug, published); no ordering column since
  // topics are few and sort by title at read time.
  @@index([projectSlug, published])
}

model Guide {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  title       String
  // Load-bearing, not decorative: drives the meta description, the OG
  // description, and the preview text on both project and topic pages. Not
  // derived from the body like `Post.summary` — a guide's description is an
  // SEO surface, written for the search result, not an excerpt.
  description String
  body        String
  // Same slug-not-FK rationale as `GuideTopic.projectSlug` above.
  projectSlug String?
  topicId     Int?
  // `Restrict`, not `Cascade` or `SetNull`: deleting a topic that still has
  // guides should fail loudly rather than silently delete published pages or
  // orphan them out of their hub.
  topic       GuideTopic? @relation(fields: [topicId], references: [id], onDelete: Restrict)
  sortOrder   Int         @default(0)
  readingTime String?
  // A DB column so the admin can stage or unpublish without deleting the row,
  // but deliberately NOT a frontmatter field — drafts live in the source
  // `drafts/` folder, so importing a file is itself the decision to publish.
  published   Boolean     @default(true)
  // The publication date, authored: the importer reads it from the filename's
  // `yyyy-MM-dd[-HHmm]-` prefix (the admin stamps it on first publish instead,
  // having no file to read). Feeds JSON-LD `datePublished`.
  //
  // A future value means scheduled — published here, held back by a read-time
  // filter (`isScheduledGuide`) until the date passes, same as a post. Null is
  // never scheduled.
  //
  // Guides are dated, but unlike `Post.datetime` the date is not the organizing
  // identity — the visible dateline reads "Updated {updatedAt}", never this.
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Real `DateTime` columns throughout — none of Post's string-datetime legacy.
  // Both list queries filter on a scope + `published`, then order by
  // `sortOrder`; these composites let Postgres return rows in order without a
  // sort step (same reasoning as `Post`'s section composite).
  @@index([topicId, published, sortOrder])
  @@index([projectSlug, published, sortOrder])
  // `findGuidesBecameLive` filters on (published, publishedAt range) with no
  // scope column, so neither composite above applies — its leftmost column is
  // missing and the query degrades to a scan. Runs once a day, negligible at
  // current row counts, and cheap to have in place before it isn't.
  @@index([published, publishedAt])
}

model Project {
  id             Int              @id @default(autoincrement())
  name           String
  slug           String           @unique
  summary        String
  // SEO-only fields, set via the import manifest (no admin-form control yet).
  // `metaTitle` drives the `<title>` tag (falls back to `name`); `keywords`
  // feeds `<meta name="keywords">`; `offers` is render-only pricing for the
  // `SoftwareApplication` JSON-LD — small and structured-data-specific, so it's
  // a `Json?` column rather than a related model (the one deliberate deviation
  // from the ProjectLink/ProjectSection related-model convention).
  metaTitle      String?
  keywords       String[]         @default([])
  offers         Json?
  // schema.org SoftwareApplication category (e.g. "BusinessApplication",
  // "ProductivityApplication"). Manifest-driven, not inferred from bucket — a
  // wrong category is worse than none, so the JSON-LD omits it when unset.
  applicationCategory String?
  icon           String?
  // `cardImage` is the list/gallery card image; `ogImage` is the social/OG
  // meta image. They cross-fall-back (see `resolveCardImage` / `resolveOgImage`):
  // card = `cardImage ?? ogImage ?? heroImage ?? first section image`, OG =
  // `ogImage ?? cardImage ?? heroImage ?? first section image`. `heroImage` is
  // the detail-page hero only and is no longer part of either fallback chain.
  cardImage      String?
  ogImage        String?
  heroImage      String?
  // `bucket` is the editorial home (drives gallery placement + compact list
  // label); `platformTags` is the honest stack (rendered on the detail page).
  // `@default([])` on platformTags keeps Postgres from returning NULL for
  // rows inserted without an explicit tag list — Prisma's TS types claim
  // non-null `PlatformTag[]` but the underlying column allows NULL unless we
  // enforce a default. Without this, a stray NULL row crashes `compactLabel`
  // with "Cannot read properties of null (reading 'length')".
  bucket         PlatformBucket
  platformTags   PlatformTag[]    @default([])
  role           String?
  accentColor    String?
  isFeatured     Boolean          @default(false)
  isDiscontinued Boolean          @default(false)
  date           String?
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sections       ProjectSection[]
  links          ProjectLink[]
  faqs           ProjectFaq[]
}

// Top-level project category. Drives gallery section grouping and the
// compact list-view label. Adding a value requires editing this enum +
// `db:push`; intentional friction since taxonomy changes are editorial.
enum PlatformBucket {
  iOS
  Mac
  Web
  OpenSource
}

// Descriptive tags for the actual stack a project uses. Rendered as-is
// (via TAG_LABELS) on the project detail page. Adding a value is the same
// dance as PlatformBucket — editorial moment, not a runtime affordance.
enum PlatformTag {
  iOS
  iPad
  watchOS
  Android
  macOS
  MenuBar
  Frontend
  Backend
  React
  Next
  Node
  Vapor
  Library
  CLI
  SDK
  Package
  Plugin
  Script
  Extension
}

model ProjectSection {
  id          Int                   @id @default(autoincrement())
  projectId   Int
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  sortOrder   Int                   @default(0)
  images      ProjectSectionImage[]
}

model ProjectSectionImage {
  id        Int            @id @default(autoincrement())
  sectionId Int
  section   ProjectSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int            @default(0)
}

model ProjectLink {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  url       String
  sortOrder Int     @default(0)
}

model ProjectFaq {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  question  String
  // Stored as markdown, rendered on read (mirrors `ProjectSection.description`).
  answer    String
  sortOrder Int     @default(0)
}
