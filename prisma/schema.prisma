generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  summary     String
  imageUrl    String?
  section     Section  @default(tech)
  slug        String
  // Stored as `yyyy-MM-dd-HHmm` string, not DateTime. Lex-sort on this format
  // matches chronological order, so `orderBy: { datetime: "desc" }` works as
  // intended. Keeping it as String avoids a disruptive migration that would
  // touch every caller (admin form, create/update routes, sitemap, feed,
  // `currentDatetimeString`, `yearFromDatetime`, `postDatetimeToISO`) for no
  // behavioural win at current scale. Revisit if timezone-aware queries or
  // cross-date range filtering become load-bearing.
  datetime    String
  readingTime String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([section, slug])
  // List queries filter on (section, published) then order by datetime DESC;
  // this composite index lets Postgres hit the right shard and return rows
  // in order without a sort step.
  @@index([section, published, datetime])
  // `legacySlug.lookupLegacySlug` queries by `slug` alone (no section). The
  // composite unique on (section, slug) can't be used efficiently for a
  // slug-only lookup (Postgres needs the leftmost prefix), so without this
  // index the query degraded to a seq scan that grew linearly with post
  // count. `getPostBySlug` is unaffected — it includes `section` and uses
  // the composite unique.
  @@index([slug])
}

// Kept in sync with `SECTIONS` in src/lib/sections.ts. Adding a new value
// requires updating both and running a Prisma migration.
enum Section {
  tech
  life
}

model Project {
  id             Int              @id @default(autoincrement())
  name           String
  slug           String           @unique
  summary        String
  icon           String?
  heroImage      String?
  // `bucket` is the editorial home (drives gallery placement + compact list
  // label); `platformTags` is the honest stack (rendered on the detail page).
  // `@default([])` on platformTags keeps Postgres from returning NULL for
  // rows inserted without an explicit tag list — Prisma's TS types claim
  // non-null `PlatformTag[]` but the underlying column allows NULL unless we
  // enforce a default. Without this, a stray NULL row crashes `compactLabel`
  // with "Cannot read properties of null (reading 'length')".
  bucket         PlatformBucket
  platformTags   PlatformTag[]    @default([])
  role           String?
  accentColor    String?
  isFeatured     Boolean          @default(false)
  isDiscontinued Boolean          @default(false)
  date           String?
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sections       ProjectSection[]
  links          ProjectLink[]
}

// Top-level project category. Drives gallery section grouping and the
// compact list-view label. Adding a value requires editing this enum +
// `db:push`; intentional friction since taxonomy changes are editorial.
enum PlatformBucket {
  iOS
  Mac
  Web
  OpenSource
}

// Descriptive tags for the actual stack a project uses. Rendered as-is
// (via TAG_LABELS) on the project detail page. Adding a value is the same
// dance as PlatformBucket — editorial moment, not a runtime affordance.
enum PlatformTag {
  iOS
  iPad
  watchOS
  Android
  macOS
  MenuBar
  Frontend
  Backend
  React
  Next
  Node
  Vapor
  Library
  CLI
  SDK
  Package
  Plugin
  Script
  Extension
}

model ProjectSection {
  id          Int                   @id @default(autoincrement())
  projectId   Int
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  sortOrder   Int                   @default(0)
  images      ProjectSectionImage[]
}

model ProjectSectionImage {
  id        Int            @id @default(autoincrement())
  sectionId Int
  section   ProjectSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int            @default(0)
}

model ProjectLink {
  id        Int     @id @default(autoincrement())
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  url       String
  sortOrder Int     @default(0)
}
