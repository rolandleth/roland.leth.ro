{
	"permissions": {
		"allow": [
			"Edit",
			"Read",
			"Write",
			"Bash(yarn dev)",
			"Bash(yarn build)",
			"Bash(yarn test)",
			"Bash(yarn test:ui)",
			"Bash(yarn lint)"
		],
		"ask": ["Bash"],
		"defaultMode": "acceptEdits"
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "node .claude/hooks/formatFile.js"
					}
				]
			}
		]
	}
}
